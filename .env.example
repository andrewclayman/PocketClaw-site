# Copy these into your Vercel project's Environment Variables. Never commit a real .env file.

# Stripe secret key (starts sk_test_ for testing, sk_live_ for real charges)
STRIPE_SECRET_KEY=

# From running `node setup-stripe.js` (see README.md)
STRIPE_PRICE_ID=
STRIPE_INTRO_COUPON_ID=

# Random long string used to sign license tokens. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this later invalidates every license token already issued.
LICENSE_SECRET=

# The deployed site's own URL, used for Stripe's success/cancel redirects.
SITE_URL=https://xanaduokapi.com
